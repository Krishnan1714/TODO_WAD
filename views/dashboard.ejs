<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>To-Do Dashboard</title>
    <link rel="stylesheet" href="/css/styles.css"> <!-- Link to your CSS -->
    <link rel="stylesheet" href="/css/style_sidebar.css">
    <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css">

</head>
<body>
     <!-- Sidebar Section -->
     <nav class="sidebar close">
        <header>
            <div class="image-text">
                <span class="image">
                    <img src="/todoicon.png" alt="image">
                </span>
                <div class="text header-text">
                    <span class="name">TO-DO LIST</span>
                </div>
            </div>
            <i class='bx bx-chevron-right toggle'></i>
        </header>

        <div class="menu-bar">
            <ul class="menu-links">
                <li class="nav-links">
                    <a href="#">
                        <i class='bx bxs-user icon'></i>
                        <span class="text nav-text">PROFILE</span>
                    </a>
                </li>
                <li class="nav-links">
                    <a href="/dashboard">
                        <i class='bx bx-home-alt icon'></i>
                        <span class="text nav-text">DASHBOARD</span>
                    </a>
                </li>
                <li class="nav-links">
                    <a href="/tasks">
                        <i class='bx bx-list-check icon'></i>
                        <span class="text nav-text">TODO LIST</span>
                    </a>
                </li>
                <li class="nav-links">
                    <a href="#">
                        <i class="bx bx-cog icon"></i>
                        <span class="text nav-text">SETTINGS</span>
                    </a>
                </li>
            </ul>

            <div class="bottom-content">
                <li class="nav-links">
                    <a href="/logout">
                        <i class='bx bx-log-out icon'></i>
                        <span class="text nav-text">LOGOUT</span>
                    </a>
                </li>

                <li class="mode">
                    <div class="moon-sun">
                        <i class="bx bx-moon icon moon"></i>
                    </div>
                    <span class="mode-text text">DARK MODE</span>
                    <div class="toggle-switch">
                        <span class="switch"></span>
                    </div>
                </li>
            </div>
        </div>
    </nav>

       <!-- Dashboard Section -->
        <section>
        <center>
        <div id="List" style="width:50%">
        <h1>Dashboard</h1>
        <div class="todo-section">
            <h2>Task Overview</h2>
            <p>Total Tasks: <%= totalTasks %></p>
            <p>Completed Tasks: <%= completedTasks %></p>
            <p>Pending Tasks: <%= pendingTasks %></p>
        </div>
    </center>
</section>
        
    </div>

    <script src="/js/app.js"></script>
    <script src="/js/script_sidebar.js"></script>
</body>
</html>
