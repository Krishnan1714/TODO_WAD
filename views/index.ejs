<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>To-Do List</title>

    <!-- Link to your CSS file -->
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/style_sidebar.css">
    <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css">
</head>
<body>
    <!-- Sidebar Section -->
    <nav class="sidebar close">
        <header>
            <div class="image-text">
                <span class="image">
                    <img src="/todoicon.png" alt="image">
                </span>
                <div class="text header-text">
                    <span class="name">TO-DO LIST</span>
                </div>
            </div>
            <i class='bx bx-chevron-right toggle'></i>
        </header>

        <div class="menu-bar">
            <ul class="menu-links">
                <li class="nav-links">
                    <a href="#">
                        <i class='bx bxs-user icon'></i>
                        <span class="text nav-text">PROFILE</span>
                    </a>
                </li>
                <li class="nav-links">
                    <a href="/dashboard">
                        <i class='bx bx-home-alt icon'></i>
                        <span class="text nav-text">DASHBOARD</span>
                    </a>
                </li>
                <li class="nav-links">
                    <a href="/tasks">
                        <i class='bx bx-list-check icon'></i>
                        <span class="text nav-text">TODO LIST</span>
                    </a>
                </li>
                <li class="nav-links">
                    <a href="#">
                        <i class="bx bx-cog icon"></i>
                        <span class="text nav-text">SETTINGS</span>
                    </a>
                </li>
            </ul>

            <div class="bottom-content">
                <li class="nav-links">
                    <a href="/logout">
                        <i class='bx bx-log-out icon'></i>
                        <span class="text nav-text">LOGOUT</span>
                    </a>
                </li>

                <li class="mode">
                    <div class="moon-sun">
                        <i class="bx bx-moon icon moon"></i>
                    </div>
                    <span class="mode-text text">DARK MODE</span>
                    <div class="toggle-switch">
                        <span class="switch"></span>
                    </div>
                </li>
            </div>
        </div>
    </nav>

    <!-- TODO Section -->
    <section>
        <center>
            <div id="List" style="width:50%">
                <h1>Your To-Do List</h1>
                <form action="/tasks/dates" method="POST">
               
                    <input type="date" name="date" required>
                    <button type="submit">Add Date</button>
                </form>

                <h2>Dates</h2>
                <ul id="dateList">
                    <% dates.forEach(function(date) { %>
                        <li>
                            <a href="#" class="date-link" class="dateItem" data-date="<%= date %>"><%= date %></a>
                        </li>
                    <% }) %>
                </ul>

                <div id="taskListContainer">
                    <% Object.keys(tasksByDate).forEach(function(date) { %>
                        <div class="taskList" data-date="<%= date %>" style="display: none;">
                            <h3>Tasks for <%= date %></h3>
                            <% if (tasksByDate[date].length>1){ %>
                            <ul>
                                <% tasksByDate[date].forEach(function(task) { %>
                                    <% if (task.task!='') { %>
                                    <li class="<%= task.completed ? 'completed' : '' %>">
                                        <%= task.task %> 
                                        <% if (!task.completed) { %>
                                            <form action="/tasks/<%= task._id %>/complete?_method=PUT" method="POST" style="display:inline;">
                                                <button type="submit">Complete</button>
                                            </form>
                                        <% } %>
                                        <form action="/tasks/<%= task._id %>?_method=DELETE" method="POST" style="display:inline;">
                                            <button type="submit">Delete</button>
                                        </form>
                                    </li>
                                    <% } %>
                                   
                                <% }) %>
                            </ul>

                            <% } %>
                            <div class="inputSection">
                            <form action="/tasks/<%= date %>/task" method="POST">
                                <input type="text"  name="task" placeholder="Enter your task" required style="background-color: white;"><br><br>
                                <button type="submit">Add Task</button>
                            </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </center>
    </section>

    <!-- Link to your JavaScript file -->
    <script src="/js/app.js"></script>
    <script src="/js/script_sidebar.js"></script>
    <script>
        document.querySelectorAll('.date-link').forEach(function(link) {
            link.addEventListener('click', function(event) {
                event.preventDefault();
                const date = this.getAttribute('data-date');
                document.querySelectorAll('.taskList').forEach(function(list) {
                    list.style.display = 'none'; // Hide all task lists
                });
                document.querySelector(`.taskList[data-date="${date}"]`).style.display = 'block'; // Show selected task list
            });
        });
    </script>
</body>
</html>
